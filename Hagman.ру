import random

def play_hangman():
    words = ["python", "гитхаб", "компьютер", "программист", "клавиатура", "монитор"]
    secret_word = random.choice(words)
    guessed_letters = set()
    attempts = 6

    print("=== Игра 'Виселица' ===")
    print("Компьютер загадал слово. У тебя есть 6 попыток на ошибку.")

    while attempts > 0:
        display_word = [letter if letter in guessed_letters else "_" for letter in secret_word]
        print("\nСлово: " + " ".join(display_word))

        if "_" not in display_word:
            print(f"\n🎉 Победа! Ты угадал слово '{secret_word}'!")
            return

        guess = input("Введи букву: ").lower().strip()

        if len(guess) != 1 or not guess.isalpha():
            print("Ошибка: введи ровно одну букву.")
            continue

        if guess in guessed_letters:
            print("Ты уже называл эту букву, попробуй другую.")
            continue

        guessed_letters.add(guess)

        if guess in secret_word:
            print("✅ Есть такая буква!")
        else:
            attempts -= 1
            print(f"❌ Нет такой буквы. Осталось попыток: {attempts}")

    print(f"\n💀 Ты проиграл. Загаданное слово было: '{secret_word}'")

if __name__ == "__main__":
    play_hangman()
